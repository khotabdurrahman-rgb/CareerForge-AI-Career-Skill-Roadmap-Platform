# Reference only; Spring Boot and the launcher do not automatically load this file.
# Set variables in the shell that starts Java. Never commit real credentials.
PORT=8090
SEED_DEMO=true
# Optional mysql profile. Create the database only; Flyway creates the tables.
DB_URL=jdbc:mysql://localhost:3306/careerforge
DB_USERNAME=careerforge_app
DB_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=careerforge@localhost
APP_BASE_URL=http://localhost:8090
# Local mail: activate smtp-file; private messages are in backend/data/mail.
